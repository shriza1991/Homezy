# ==========================================
# Homezy Project Environment Configuration Overview
# ==========================================
# Homezy uses separate environment files for the server and client:
#
# Server: server/.env (see server/.env.example)
# Client: client/.env (see client/.env.example)
#
# --- SERVER CONFIGURATION (server/.env) ---
# PORT=5000
# NODE_ENV=development
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/property_rental_portal?retryWrites=true&w=majority
# MONGO_TIMEOUT_MS=5000
# JWT_SECRET=homezy_jwt_secret_key_change_in_production
# CLIENT_ORIGIN=http://localhost:5173
#
# --- CLIENT CONFIGURATION (client/.env) ---
# VITE_API_URL=http://localhost:5000/api
