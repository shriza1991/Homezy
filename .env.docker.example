# Copy to .env.docker (PowerShell: Copy-Item .env.docker.example .env.docker).
# Always pass --env-file .env.docker to docker compose.
MONGO_URI=mongodb://mongo:27017/homezy_docker_demo
# Replace locally with a random secret, e.g.:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-before-starting
# Host ports and the server's internal listening port:
CLIENT_PORT=8080
SERVER_PORT=5000
PORT=5000
CLIENT_ORIGIN=http://localhost:8080
# Public browser URL, NOT http://server:5000. Baked into the Vite build.
VITE_API_URL=http://localhost:5000/api
