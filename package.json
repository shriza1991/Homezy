{
  "name": "homezy",
  "version": "1.0.0",
  "description": "Homezy - Full Stack Property Rental Portal",
  "private": true,
  "scripts": {
    "start": "npm run server:start",
    "server:start": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "server:test": "npm test --prefix server",
    "seed": "npm run seed --prefix server",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "client:lint": "npm run lint --prefix client",
    "client:test": "npm test --prefix client",
    "test:demo": "node --test test/demoBrowser.test.js",
    "test:docker": "node scripts/verify-docker.cjs",
    "test:all": "npm run server:test && npm run client:test && npm run test:demo",
    "test": "npm run server:test && npm run client:test && npm run test:demo"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0"
  }
}
