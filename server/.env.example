# ==========================================
# Homezy Backend Server Environment Configuration
# ==========================================

# Port the Express server listens on (default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------
# MongoDB Database Connection
# ------------------------------------------
# For MongoDB Atlas (Recommended):
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details.
# Note: Ensure special characters in your password are URL-encoded (e.g. '@' -> '%40').
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/property_rental_portal?retryWrites=true&w=majority

# For Local MongoDB (Alternative):
# MONGO_URI=mongodb://localhost:27017/property_rental_portal

# Timeout in milliseconds for database server selection (default: 5000)
MONGO_TIMEOUT_MS=5000

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Secret key used for signing JWT tokens. Replace with a secure random string in production.
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# ------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------
# Allowed origins for frontend clients (comma-separated if multiple, or * for all in dev)
CLIENT_ORIGIN=http://localhost:5173
